# ChantePaFo backend configuration
# Copy this file to `.env` and adjust values for your environment.
# All variables are prefixed with CHANTEPAFO_ and loaded by pydantic-settings.

CHANTEPAFO_DATABASE_URL=postgresql+asyncpg://chantepafo:chantepafo_dev@localhost:5432/chantepafo
CHANTEPAFO_REDIS_URL=redis://localhost:6379
CHANTEPAFO_SECRET_KEY=dev-secret-change-in-production
CHANTEPAFO_DEEZER_API_BASE=https://api.deezer.com
CHANTEPAFO_UPLOAD_DIR=uploads
CHANTEPAFO_CORS_ORIGINS=["http://localhost:5173"]
