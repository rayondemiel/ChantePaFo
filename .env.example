# ChantePaFo — docker-compose configuration
# Copy this file to `.env` at the repo root and adjust values if needed.
# These variables are consumed by docker-compose.yml.

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=chantepafo_dev

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_USER=chantepafo
POSTGRES_PASSWORD=chantepafo_dev
POSTGRES_DB=chantepafo

# Redis Exporter (Prometheus sidecar)
REDIS_EXPORTER_PORT=9121
