#!/usr/bin/env sh
# Backend: ruff check + format (fail-fast)
export PATH="$HOME/.local/bin:$PATH"
(cd "$(git rev-parse --show-toplevel)/backend" && uv run ruff check --fix . && uv run ruff format .) || exit 1

# Frontend: lint-staged (runs eslint + prettier on staged files)
(cd "$(git rev-parse --show-toplevel)/frontend" && npx lint-staged) || exit 1
